{
  "rules": {
    ".read": false,
    ".write": false,
    "accountQuota": {
      ".read": false,
      ".write": false
    },
    "tvWatchlist": {
      ".read": true,
      ".write": false
    },
    "theaterSync": {
      ".read": true,
      ".write": false,
      "doorMode": {
        ".read": true,
        ".write": "(auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')) || (newData.isString() && (newData.val() == 'force_open' || newData.val() == 'force_closed' || newData.val() == 'auto'))"
      },
      "pendingRequests": {
        ".read": true,
        ".write": false,
        "$reqId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id', 'title', 'requester', 'timestamp']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 120 && newData.child('requester').isString() && newData.child('requester').val().length <= 50"
        }
      },
      "plexUsers": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')",
        "$userId": {
          ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com') || (!data.exists() && newData.exists() && newData.child('status').val() == 'pending')",
          ".validate": "newData.hasChildren(['usernameOrEmail'])"
        }
      },
      "plexRequests": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')",
        "$reqId": {
          ".write": "true",
          ".validate": "newData.hasChildren(['id', 'emailOrUsername', 'timestamp']) && newData.child('emailOrUsername').isString() && newData.child('emailOrUsername').val().length > 0 && newData.child('emailOrUsername').val().length <= 100"
        }
      },
      "requests": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')",
        "$reqId": {
          ".write": "(!data.exists() && newData.exists()) || (auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com'))",
          ".validate": "!newData.exists() || (newData.hasChildren(['title', 'requester']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 200)"
        }
      },
      "moviePosters": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')",
        "$movieTitle": {
          ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')"
        }
      },
      "officialSchedule": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')"
      },
      "schedule": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'briandivacox@gmail.com' || auth.token.email == 'brian@brianstheater.com' || auth.token.email == 'brian.diva.cox@gmail.com')"
      },
      "nowPlaying": {
